# Copy into the .env at the root of the folder you open in VS Code (never commit it).
# Edits apply on the next message; no reload needed.
# Quote any value containing '#' (Fireworks LoRA model ids do): editors and some dotenv tools treat it as a comment.

# Each agent group picks its own provider: baseten | fireworks.
# Key lookup:   <PREFIX>_API_KEY, else the provider's key below.
# Base URL:     <PREFIX>_BASE_URL, else the provider's default.

# --- Provider keys ---
BASETEN_API_KEY=
FIREWORKS_API_KEY=

# --- Main agents (orchestrator, developer, QA, version control) ---
# ROOTCODE_PROVIDER=baseten                     # default: baseten
# ROOTCODE_MODEL=meta-models/muse-spark-open-1026   # default for baseten; required for fireworks
# ROOTCODE_API_KEY=                             # overrides the provider key
# ROOTCODE_BASE_URL=                            # default: https://inference.baseten.co/v1 or https://api.fireworks.ai/inference/v1
# ROOTCODE_MAX_TOKENS=8192
# ROOTCODE_REASONING_EFFORT=medium              # Muse Spark Open on Baseten only
# ROOTCODE_STREAM=true                          # false disables live streaming

# --- PR review agent ---
# PR_REVIEW_PROVIDER=fireworks                  # default: fireworks
PR_REVIEW_MODEL="accounts/<account>/models/<model>#accounts/<account>/deployments/<deployment-id>"
# PR_REVIEW_API_KEY=
# PR_REVIEW_BASE_URL=
# PR_REVIEW_MAX_TOKENS=4000
# PR_REVIEW_REASONING_EFFORT=

# --- GitHub MCP (PR review agent): token needs pull request read/write access ---
GITHUB_TOKEN=
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GITHUB_MCP_TOOLSETS=context,repos,pull_requests

# =====================================================================
# Fine-tuning (the "Fine-tune on your codebase" flow). All optional unless noted.
# Precedence for everything above and below: <folder>/.env, then the process environment, then VS Code settings.
# =====================================================================

# --- Which provider trains the LoRA: baseten | fireworks (default baseten) ---
# LORA_PROVIDER=baseten

# --- Baseten training ---
# BASETEN_BASE_MODEL=meta-models/muse-spark-open-1026
# BASETEN_GPU=H100
# BASETEN_GPU_COUNT=1
# BASETEN_DEPLOY_GPU=H100                       # GPU for the deployed adapter (default: BASETEN_GPU)
# BASETEN_HF_SECRET_NAME=hf_access_token        # name of the Baseten secret holding your Hugging Face token

# --- Fireworks training ---
# FIREWORKS_ACCOUNT_ID=
# FIREWORKS_BASE_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
# FIREWORKS_TRAINING_MODE=serverless            # serverless | managed
# FIREWORKS_DEPLOYMENT_ID=

# --- Training hyperparameters and behaviour ---
# LORA_RANK=16
# LORA_LEARNING_RATE=0.0002
# LORA_EPOCHS=3
# LORA_MAX_SEQ_LEN=4096
# LORA_LOAD_IN_4BIT=true
# LORA_N_EVAL=16
# LORA_ALLOW_PAID=false                         # Fireworks serverless: allow steps that incur charges
# LORA_DOWNLOAD_ADAPTER=true                    # save the adapter to <folder>/.repo2lora/adapters
# LORA_AUTO_DEPLOY=true                         # deploy the trained adapter automatically

# --- Use your trained endpoint for the main agents ---
# ROOTCODE_MODEL_SOURCE=trained-endpoint        # baseten-model-api (default) | trained-endpoint

# --- Dataset generation ---
# REPO2LORA_WHEEL=/absolute/path/to/repo2lora-<version>-py3-none-any.whl   # default: the wheel bundled in resources/
