{
  "name": "rootcode",
  "publisher": "rootcode",
  "displayName": "Rootcode",
  "description": "Rootcode builds a living dependency graph of your codebase, trains a personalized agent on your internal patterns, conventions, and engineering history, and delivers code suggestions that don’t just work — they fit. No more generically correct code that violates your architecture. The longer your team uses it, the smarter it gets.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rootcode",
          "title": "Rootcode",
          "icon": "media/rootcode.svg"
        }
      ]
    },
    "views": {
      "rootcode": [
        {
          "id": "rootcode.welcome",
          "name": "Welcome",
          "type": "webview",
          "contextualTitle": "Rootcode Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "rootcode.open",
        "title": "Rootcode: Open Studio",
        "icon": "$(circuit-board)"
      },
      {
        "command": "loraTrainer.startTraining",
        "title": "LoRA: Start Fine-Tuning Job"
      },
      {
        "command": "loraTrainer.checkStatus",
        "title": "LoRA: Check Job Status"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rootcode.open"
        },
        {
          "command": "loraTrainer.startTraining"
        },
        {
          "command": "loraTrainer.checkStatus"
        }
      ]
    },
    "configuration": {
      "title": "LoRA Trainer",
      "properties": {
        "loraTrainer.provider": {
          "type": "string",
          "enum": [
            "fireworks",
            "baseten"
          ],
          "default": "baseten",
          "description": "Training provider"
        },
        "loraTrainer.fireworksApiKey": {
          "type": "string",
          "default": "",
          "description": "FireworksAI API key (falls back to FIREWORKS_API_KEY env var)"
        },
        "loraTrainer.basetenApiKey": {
          "type": "string",
          "default": "",
          "description": "Baseten API key (falls back to BASETEN_API_KEY env var)"
        },
        "loraTrainer.baseModel": {
          "type": "string",
          "default": "",
          "description": "Base model to fine-tune. Empty = meta-models/muse-spark-open-1026 on Baseten, accounts/fireworks/models/llama-v3p1-8b-instruct on Fireworks"
        },
        "loraTrainer.loraRank": {
          "type": "number",
          "default": 16
        },
        "loraTrainer.learningRate": {
          "type": "number",
          "default": 0.0002
        },
        "loraTrainer.epochs": {
          "type": "number",
          "default": 3
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm exec --yes --package @vscode/vsce -- vsce package --allow-missing-repository --skip-license",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "test:workflow": "npm run compile-tests && mocha --ui tdd out/test/workflow.test.js",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "muse-lora-trainer": "file:../muse-lora-trainer"
  }
}
